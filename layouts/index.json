{{- /*
  星系共用：每本 handbook / 書 build 出 /index.json，供 nplus-father portal 匯總「已 review」進度。
  reviewable 單位 = docs/ 底下每個 _index.md（一個主題頁）；每筆另帶 `leaf`
  （true = 底下沒有子頁，即真正的葉章節），讓消費端自行決定要算全部頁或只算葉章節。
  某頁「已 review」的判準：frontmatter `reviewed: true`（可再加 `reviewedDate: "YYYY-MM-DD"`）。
  books-done 的 Hugo 書用 `read` / `readAt` 慣例，這裡一併吃並映射到同樣的欄位。
  未設 = 未 review（乾淨基線，不需逐頁 stamp）。

  `kind` 預設 "book"，由手冊自行覆寫——站台數量懸殊（約 1620 本書 vs 11 本
  手冊），讓少數的一邊宣告成本最低。手冊在自己的 hugo.toml 加：
      [params]
      stationKind = "handbook"
*/ -}}
{{- $items := slice -}}
{{- range where site.Pages "Section" "docs" -}}
  {{- if .File -}}
    {{- $reviewed := or (eq .Params.reviewed true) (eq .Params.read true) -}}
    {{- $reviewedDate := or .Params.reviewedDate .Params.readAt | default "" -}}
    {{- $items = $items | append (dict
        "id" .File.Path
        "title" .Title
        "url" .Permalink
        "weight" .Weight
        "leaf" (eq (len .Pages) 0)
        "reviewed" $reviewed
        "reviewedDate" $reviewedDate
    ) -}}
  {{- end -}}
{{- end -}}
{{- /*
  `book` republishes the home page's `book:` frontmatter — title, author,
  publication date, purchase link and the one-line blurb. The portal used to
  recover these by splitting the GitHub repo description on "|": a positional
  format capped at 350 characters that silently shifted every field if a title
  contained a separator. Here they are named fields with no length limit,
  emitted by the site that owns them.

  Empty on sites not yet migrated, so consumers must keep their fallback.
*/ -}}
{{- $book := dict -}}
{{- with site.Home.Params.book -}}
  {{- $book = . -}}
{{- end -}}
{{- dict
    "station" (path.Base (strings.TrimSuffix "/" site.BaseURL))
    "brand" site.Title
    "kind" (site.Params.stationKind | default "book")
    "book" $book
    "count" (len $items)
    "items" $items
  | jsonify (dict "indent" "  ") -}}
